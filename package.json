{
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "scripts": {
    "verify": "pnpm --filter trust-pipeline run verify",
    "graphql:generate": "pnpm --filter server run dev:codegen",
    "codegen": "pnpm --filter server run dev:codegen && pnpm --filter admin run codegen && pnpm --filter blog run codegen",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:coverage": "pnpm -r --workspace-concurrency=1 run test:coverage",
    "product": "headroom wrap opencode -- mini --agent product-dev",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pm2": "^7.0.4"
  }
}
