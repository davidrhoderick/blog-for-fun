{
  "name": "admin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run relay && react-router build",
    "dev": "pnpm run relay && react-router dev",
    "relay": "pnpm --dir .. run graphql:generate && relay-compiler relay.config.json",
    "relay:watch": "pnpm --dir .. run graphql:generate && relay-compiler --watch relay.config.json",
    "start": "react-router-serve ./build/server/index.js",
    "test": "tsx --test \"app/**/*.test.ts\"",
    "typecheck": "pnpm run relay && react-router typegen && tsc"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@blog/graphql-runtime": "workspace:*",
    "@blog/ui": "workspace:*",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mdxeditor/editor": "^4.3.0",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.88.0",
    "react-relay": "^21.0.1",
    "react-router": "^8",
    "relay-runtime": "^21.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-relay": "^21.0.1",
    "relay-compiler": "^21.0.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-plugin-relay": "^2.1.0"
  }
}
