{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:codegen": "graphql-codegen && cp src/schema/schema.generated.graphqls src/schema/schema.generated.graphql",
    "dev:codegen:watch": "graphql-codegen --watch",
    "dev:server": "tsx watch src/server.ts",
    "dev": "pnpm run dev:codegen && concurrently --kill-others-on-fail -n codegen,server \"pnpm run dev:codegen:watch\" \"pnpm run dev:server\"",
    "build": "node esbuild.config.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "auth:bootstrap": "tsx src/scripts/bootstrap-auth.ts",
    "auth:recover": "tsx src/scripts/recover-password.ts",
    "storage:dev": "docker run --rm -p 9000:9000 -p 9001:9001 -e MINIO_ROOT_USER=test -e MINIO_ROOT_PASSWORD=testtest -v \"$PWD/.local/media:/data\" minio/minio server /data --console-address :9001",
    "storage:configure-cors": "tsx src/scripts/configure-media-cors.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@inquirer/prompts": "^8.7.2",
    "@libsql/client": "^0.17.4",
    "@node-rs/argon2": "^2.2.1",
    "cookie": "^2.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "graphql": "^16.0.0",
    "graphql-scalars": "^2.0.1",
    "graphql-yoga": "^5.21.2",
    "tsx": "^4.23.9"
  },
  "devDependencies": {
    "@eddeee888/gcg-typescript-resolver-files": "^0.17.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@parcel/watcher": "^2.6.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.4",
    "aws-sdk-client-mock": "^4.1.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
