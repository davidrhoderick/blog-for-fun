# The server reads `apps/server/.env` from its own package, so this file stays
# contained to this app and deploys with it. Copy this example to `.env` and
# fill in your own values.
#
# Only the TURSO_* pair is required to boot. The storage block is needed only
# for media uploads, and the bootstrap block only for
# `pnpm --filter server auth:bootstrap`.

# --- Required: libSQL/Turso database ---
# A local file database, no account needed:
TURSO_CONNECTION_URL=file:local.db
TURSO_AUTH_TOKEN=local-token
# ...or your Turso database. Keep real values out of version control:
# TURSO_CONNECTION_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=<token>

# --- Optional: server bind (defaults shown) ---
# HOST=127.0.0.1
# PORT=4000

# --- Optional: S3-compatible media storage ---
# These four are required together, but only once you use media:
# AWS_ENDPOINT_URL_S3=http://127.0.0.1:9000
# BUCKET_NAME=media
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=testtest
# AWS_REGION=auto
# S3_FORCE_PATH_STYLE=true
# MEDIA_PUBLIC_URL=http://127.0.0.1:9000/media
# MEDIA_OBJECT_ACL=public-read

# --- Bootstrap only: pnpm --filter server auth:bootstrap ---
# BOOTSTRAP_EMAIL=admin@example.com
# BOOTSTRAP_DISPLAY_NAME=Blog Administrator
