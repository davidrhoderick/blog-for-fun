{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "plugins": [
    {
      "path": "./biome/plugins/no-jsx-in-memo.grit",
      "includes": ["**/apps/admin/**", "**/apps/blog/**"]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        }
      },
      "nursery": {
        "noExcessiveNestedCallbacks": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "admin",
                      "admin/**",
                      "**/../admin",
                      "**/../admin/**"
                    ],
                    "message": "apps/server must not import the admin app; share code through packages/ instead."
                  },
                  {
                    "group": ["blog", "blog/**", "**/../blog", "**/../blog/**"],
                    "message": "apps/server must not import the blog app; share code through packages/ instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/admin/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "server",
                      "server/**",
                      "**/../server",
                      "**/../server/**"
                    ],
                    "message": "apps/admin must not import the server app; share code through packages/ instead."
                  },
                  {
                    "group": ["blog", "blog/**", "**/../blog", "**/../blog/**"],
                    "message": "apps/admin must not import the blog app; share code through packages/ instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/blog/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "server",
                      "server/**",
                      "**/../server",
                      "**/../server/**"
                    ],
                    "message": "apps/blog must not import the server app; share code through packages/ instead."
                  },
                  {
                    "group": [
                      "admin",
                      "admin/**",
                      "**/../admin",
                      "**/../admin/**"
                    ],
                    "message": "apps/blog must not import the admin app; share code through packages/ instead."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
